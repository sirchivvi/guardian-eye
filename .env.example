# =============================================================================
# GuardianEye — environment variable template
#
# Copy this file to .env and fill in the real values.
# NEVER commit a .env file containing real credentials.
# =============================================================================

# ---------------------------------------------------------------------------
# Path overrides
# Precedence: CLI argument > env var > config.yaml default
# ---------------------------------------------------------------------------

# Root directory containing dataset sub-folders (data/raw/<dataset>/)
# DATA_ROOT=/path/to/your/data

# Root directory for results, checkpoints, and archives
# RESULTS_ROOT=/path/to/your/results

# ---------------------------------------------------------------------------
# Cloud storage (for Colab / Kaggle workflows — optional)
# ---------------------------------------------------------------------------

# Google Drive mount point when running on Colab
# GDRIVE_ROOT=/content/drive/MyDrive/guardian-eye

# Kaggle API credentials (set via Kaggle secrets UI — do NOT paste here)
# KAGGLE_USERNAME=your_kaggle_username
# KAGGLE_KEY=your_kaggle_api_key

# ---------------------------------------------------------------------------
# Weights & Biases (optional experiment tracking — Phase 1+)
# ---------------------------------------------------------------------------
# WANDB_API_KEY=your_wandb_key
# WANDB_PROJECT=guardian-eye
# WANDB_ENTITY=your_team
